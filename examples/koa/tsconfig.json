{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["ESNext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": false,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["./src/**/*.ts"]
}
