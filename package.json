{
	"name": "http-controller-abstractions",
	"version": "0.1.0",
	"description": "Tiny TypeScript library for testable, clutter-free, framework-agnostic controllers with strong type-safety",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"prepare": "husky",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"build": "tsc -p tsconfig.json",
		"build:watch": "tsc -p tsconfig.json --watch",
		"build:clean": "rm -rf dist",
		"commit:lint": "commitlint --edit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"husky": "^9.1.7",
		"typescript": "^7.0.2"
	}
}
