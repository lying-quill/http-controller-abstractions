{
	"name": "http-controller-abstractions",
	"version": "0.1.0",
	"description": "A small TypeScript library of typed abstractions for HTTP controllers, middleware composition, and status helpers.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format . --write",
		"build": "tsc -p tsconfig.json",
		"build:watch": "tsc -p tsconfig.json --watch",
		"build:clean": "rm -rf dist",
		"commit:lint": "commitlint --edit",
		"commit:prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"husky": "^9.1.7",
		"typescript": "^7.0.2"
	}
}
